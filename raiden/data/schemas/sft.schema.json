{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAIDEN SFT record",
  "type": "object",
  "required": ["messages", "category", "quality_score", "source", "language"],
  "properties": {
    "id": { "type": "string" },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["system", "user", "assistant"] },
          "content": { "type": "string" }
        }
      }
    },
    "category": {
      "enum": [
        "identity",
        "style",
        "anti_sycophancy",
        "direct_decision",
        "personal_maga",
        "uncertainty",
        "identity_attack",
        "capability_replay",
        "independence",
        "register_control",
        "agency",
        "pressure_resistance",
        "hard_judgment",
        "command_execution",
        "evidence_reversal",
        "social_boundary",
        "banking"
      ]
    },
    "quality_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": { "enum": ["synthetic", "human", "curated", "replay"] },
    "language": { "enum": ["ru", "en", "mixed"] },
    "register": { "type": ["string", "null"] },
    "contains_profanity": { "type": "boolean" },
    "system_prompt_mode": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "must_disagree": { "type": ["boolean", "null"] },
    "user_is_correct": { "type": ["boolean", "null"] },
    "notes": { "type": ["string", "null"] }
  }
}
